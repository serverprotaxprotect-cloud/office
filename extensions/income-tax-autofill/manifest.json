{
  "manifest_version": 3,
  "name": "GeeBharat Income Tax Autofill",
  "version": "1.0.0",
  "description": "Autofills Income Tax portal login from GeeBharat one-time tokens.",
  "host_permissions": [
    "https://eportal.incometax.gov.in/*",
    "https://geebharat.com/*",
    "http://localhost:*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://eportal.incometax.gov.in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
